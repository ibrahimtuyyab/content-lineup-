# ContentLineup — content database configuration
#
#   cp .env.example .env
#
# All three values are in your Supabase dashboard under
#   Settings → API   (or Settings → API Keys on newer projects)
#
# Leave this file unconfigured and the site falls back to the local SQLite
# mirror at data/content.db, so the build keeps working either way.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# anon / publishable key — read-only in practice, because Row Level Security
# only exposes published posts. Safe for builds and for CI.
SUPABASE_ANON_KEY=

# service_role / secret key — full access, bypasses RLS.
# Needed only by db:push, the CLI and the admin UI.
# NEVER commit this, and never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token — only needed to create tables (npm run db:apply).
# Create at https://supabase.com/dashboard/account/tokens and revoke afterwards.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Neon (Vercel Postgres) — the production content database.
# Vercel injects this automatically for a connected Neon store; you only need
# it locally. Copy from: Vercel -> project -> Storage -> Neon -> .env.local
# or run: vercel env pull .env.local
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Admin login (npm run admin)
#
# The admin binds to loopback, but that only keeps the network out — it does
# nothing about a browser tab left open on a shared machine. Set these and it
# asks for a username and password.
#
# Leave them blank and the admin runs with no login, exactly as it used to.
#
# Do not write the password here. Run:  npm run admin:password
# It prompts for one, stores a scrypt hash of it as ADMIN_PASSWORD_HASH, and
# generates the session secret.
# ---------------------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Rotating it signs every open session out.
# Leave blank and one is generated per start, so a restart signs you out.
ADMIN_SESSION_SECRET=

# Deploy hook, for the admin's "Rebuild site" button on a Vercel deployment.
#
# The published site is static: an edit lands in the database at once, but the
# pages people read are the ones written at the last build. This is how the
# admin asks Vercel for a new one. Create it at:
#   Vercel -> Project -> Settings -> Git -> Deploy Hooks
#
# Only needed in the Vercel environment; locally the button runs the build.
VERCEL_DEPLOY_HOOK_URL=
