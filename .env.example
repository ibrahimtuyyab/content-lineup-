# ContentLineup — content database configuration
#
#   cp .env.example .env
#
# All three values are in your Supabase dashboard under
#   Settings → API   (or Settings → API Keys on newer projects)
#
# Leave this file unconfigured and the site falls back to the local SQLite
# mirror at data/content.db, so the build keeps working either way.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# anon / publishable key — read-only in practice, because Row Level Security
# only exposes published posts. Safe for builds and for CI.
SUPABASE_ANON_KEY=

# service_role / secret key — full access, bypasses RLS.
# Needed only by db:push, the CLI and the admin UI.
# NEVER commit this, and never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token — only needed to create tables (npm run db:apply).
# Create at https://supabase.com/dashboard/account/tokens and revoke afterwards.
SUPABASE_ACCESS_TOKEN=
